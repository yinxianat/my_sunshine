# ── PostgreSQL (Amazon RDS) ──────────────────────────────────────────────────
PG_HOST=your-rds-host.us-west-2.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=mysunshine
PG_USER=mysunshine_admin
PG_PASSWORD=your-db-password

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mysunshine?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=us-west-2
S3_BUCKET=mysunshine-media

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to Google Account → Security → App Passwords
# 3. Generate a password for "Mail" and paste it below
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── App URL (used in email links for magic link / password reset) ────────────
APP_URL=https://mysunshine.app

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
